# Copy to services/.env and replace every value. scripts/up.sh, scripts/down.sh and docker compose read it.
# These are local-only demo values. Pick your own random strings.

# Shared HS256 secret that auth signs with and every service verifies. Use 32 or more random characters.
JWT_SECRET=replace-with-a-long-random-string-for-local-use

# MariaDB credentials for the dbs database in docker-compose.yml.
DB_PASSWORD=replace-with-a-db-password
DB_ROOT_PASSWORD=replace-with-a-root-password

# Optional overrides.
# DB_USER=dbs
# DB_PORT=3307
