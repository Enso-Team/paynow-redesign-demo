// Copy to Local.xcconfig (gitignored) and fill in your own values.

// Your Apple Developer team id, needed to sign for a device. The simulator builds without it.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// The Mac running the services, as the iPhone reaches it (for example its Tailscale MagicDNS name).
DBS_BACKEND_HOST_DEVICE = your-mac.example.ts.net
